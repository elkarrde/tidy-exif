{
  "folders": [
    {
      "name": "tidy-exif",
      "path": "./",
      "folder_exclude_patterns": [
        ".git", ".github", ".claude", "dist"
      ],
      "file_exclude_patterns": [
        "*.bak", "*.sublime-workspace",
        "*.tar.gz", "*.zip",
        "tidy-exif", "tidy-exif.exe", "tidy-exif-arm64"
      ]
    }
  ],
  "settings": {
    "translate_tabs_to_spaces": true,
    "trim_automatic_white_space": true,
    "trim_trailing_white_space_on_save": true,
    "rulers": [80, 100],
    "highlight_line": true,
    "word_wrap": false,
    "highlight_modified_tabs": true,
    "find_selected_text": true,
    "default_line_ending": "unix"
  },
  "build_systems": [
    {
      "name": "tidy-exif: build",
      "shell_cmd": "make build",
      "working_dir": "${project_path}",
      "file_regex": "^(.+\\.go):([0-9]+):([0-9]+):"
    },
    {
      "name": "tidy-exif: build (windows)",
      "shell_cmd": "make build-windows",
      "working_dir": "${project_path}",
      "file_regex": "^(.+\\.go):([0-9]+):([0-9]+):"
    },
    {
      "name": "tidy-exif: build (arm64)",
      "shell_cmd": "make build-arm64",
      "working_dir": "${project_path}",
      "file_regex": "^(.+\\.go):([0-9]+):([0-9]+):"
    },
    {
      "name": "tidy-exif: test",
      "shell_cmd": "go test ./...",
      "working_dir": "${project_path}",
      "file_regex": "^(.+\\.go):([0-9]+):([0-9]+):"
    },
    {
      "name": "tidy-exif: dist",
      "shell_cmd": "make dist",
      "working_dir": "${project_path}",
      "file_regex": "^(.+\\.go):([0-9]+):([0-9]+):"
    },
    {
      "name": "tidy-exif: clean",
      "shell_cmd": "make clean",
      "working_dir": "${project_path}",
      "file_regex": "^(.+\\.go):([0-9]+):([0-9]+):"
    }
  ]
}
