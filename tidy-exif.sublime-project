{
  "folders": [
    {
      "name": "tidy-exif",
      "path": "./",
      "folder_exclude_patterns": [
        ".git", ".github", ".claude"
      ],
      "file_exclude_patterns": [
        "*.bak", "*.sublime-workspace", "tidy-exif", "tidy-exif.exe"
      ]
    }
  ],
  "settings": {
    "translate_tabs_to_spaces": true,
    "trim_automatic_white_space": true,
    "trim_trailing_white_space_on_save": true,
    "rulers": [80, 100],
    "highlight_line": true,
    "word_wrap": false,
    "highlight_modified_tabs": true,
    "find_selected_text": true,
    "default_line_ending": "unix"
  },
  "build_systems": [
    {
      "name": "tidy-exif: build",
      "shell_cmd": "go build -o tidy-exif .",
      "working_dir": "${project_path}",
      "file_regex": "^(.+\\.go):([0-9]+):([0-9]+):"
    },
    {
      "name": "tidy-exif: build (windows)",
      "shell_cmd": "GOOS=windows GOARCH=amd64 go build -o tidy-exif.exe .",
      "working_dir": "${project_path}",
      "file_regex": "^(.+\\.go):([0-9]+):([0-9]+):"
    },
    {
      "name": "tidy-exif: test",
      "shell_cmd": "go test ./...",
      "working_dir": "${project_path}",
      "file_regex": "^(.+\\.go):([0-9]+):([0-9]+):"
    }
  ]
}
